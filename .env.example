# ==========================================
# BANCO DE DADOS E CACHE
# ==========================================
# URL principal de conexao com o PostgreSQL (Prisma)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/pflix"
# URL de banco shadow para migracoes Prisma (opcional)
SHADOW_DATABASE_URL=""
# Senha do container PostgreSQL no docker-compose
POSTGRES_PASSWORD=""
# URL do Redis para cache e filas (opcional)
REDIS_URL="redis://localhost:6379"

# ==========================================
# AUTENTICACAO E APLICACAO (NEXTAUTH / APP)
# ==========================================
# Ambiente de execucao (development, production, test)
NODE_ENV="development"
# Segredo para assinar tokens JWT do NextAuth e sessao mobile
NEXTAUTH_SECRET=""
# URL base do NextAuth
NEXTAUTH_URL="http://localhost:3000"
# URL publica do app no navegador
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Origens permitidas no CORS separadas por virgula
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Nivel de log do Winston (info, warn, error, debug)
LOG_LEVEL="info"

# ==========================================
# ADMINISTRACAO E SEED
# ==========================================
# Email do administrador inicial (usado no seed, scripts e contato padrao)
ADMIN_EMAIL="admin@exemplo.com"
# Senha do administrador inicial (minimo de 12 caracteres)
ADMIN_PASSWORD=""

# ==========================================
# MOBILE E RECURSOS PUBLICOS
# ==========================================
# URL publica para download do arquivo APK Android (se vazio, oculta o botao)
NEXT_PUBLIC_APK_URL=""
# Habilita aba/modo Lab no frontend (true ou false)
NEXT_PUBLIC_LAB_ENABLED="false"
# SHA de commit exposto no cliente para identificacao de build (opcional)
NEXT_PUBLIC_COMMIT_SHA=""

# ==========================================
# STORAGE WASABI S3 (VIDEO HLS E MUSICA)
# ==========================================
# Credenciais e bucket do Wasabi compartilhados entre video HLS e musica (prefixo music/)
WASABI_ACCESS_KEY_ID=""
WASABI_SECRET_ACCESS_KEY=""
WASABI_BUCKET_NAME=""
WASABI_ENDPOINT="https://s3.us-east-1.wasabisys.com"
WASABI_REGION="us-east-1"
# URL da CDN na frente do bucket Wasabi
WASABI_CDN_URL=""
# URL base alternativa para streams HLS
HLS_BASE_URL=""

# ==========================================
# CLOUDFLARE (CDN, CACHE E STREAM WORKER)
# ==========================================
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_KEY=""
CLOUDFLARE_EMAIL=""
CLOUDFLARE_WORKER_URL=""
CLOUDFLARE_WORKER_SECRET=""

# ==========================================
# TRANSCODER E METADADOS DE VIDEO
# ==========================================
# URL base do servico Python de transcodificacao HLS (obrigatorio para status/jobs)
TRANSCODER_BASE_URL=""
# Chave da API do The Movie Database (TMDb)
TMDB_API_KEY=""
# Chave da API do OpenSubtitles
OPENSUBTITLES_API_KEY=""

# ==========================================
# MUSICA (MUSICBRAINZ)
# ==========================================
# Identificacao para chamadas na API do MusicBrainz
MUSICBRAINZ_USER_AGENT=""
MUSICBRAINZ_APP_NAME="pflix"
MUSICBRAINZ_CONTACT=""

# ==========================================
# INTELIGENCIA ARTIFICIAL E RECOMENDACOES
# ==========================================
GROQ_API_KEY=""
CLAUDE_KEY=""
CLAUDE_MODEL=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_MODEL_CATALOG=""
OPENROUTER_MODEL_TAGLINE=""

# ==========================================
# PAGAMENTOS: PROVEDORES
# ==========================================
# Define provedor ativo (ASAAS ou INTER)
PAYMENTS_PROVIDER="ASAAS"
PAYMENT_PROVIDER="ASAAS"
PAYMENTS_PROVIDER_DEFAULT="ASAAS"
PAYMENTS_PROVIDER_PIX="ASAAS"
PAYMENTS_PROVIDER_BOLETO="ASAAS"

# ==========================================
# PAGAMENTOS: ASAAS
# ==========================================
ASAAS_API_KEY=""
ASAAS_API_URL=""
ASAAS_KEY_SANDBOX=""
ASAAS_KEY_PRODUCTION=""
ASAAS_KEY_PROD=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_WEBHOOK_ACCESS_TOKEN=""

# ==========================================
# PAGAMENTOS: BANCO INTER
# ==========================================
# Ambiente Inter (SANDBOX ou PRODUCTION)
INTER_ENV="SANDBOX"
INTER_ENVIRONMENT="SANDBOX"
INTER_CLIENT_ID=""
CLIENT_ID=""
INTER_CLIENT_SECRET=""
CLIENT_SECRET=""
INTER_CONTA_CORRENTE=""
X_INTER_CONTA_CORRENTE=""
# Certificados mTLS (caminho ou conteudo PEM em base64)
INTER_CERTIFICATE=""
CERTIFICATE=""
INTER_CERT=""
CERT=""
INTER_PRIVATE_KEY=""
PRIVATE_KEY=""
INTER_KEY=""
KEY=""
INTER_CERT_PASSPHRASE=""
CERT_PASSPHRASE=""
# Chave Pix e expiracao
INTER_PIX_KEY=""
INTER_CHAVE_PIX=""
INTER_PIX_CHAVE=""
PIX_KEY=""
INTER_PIX_EXPIRATION_SECONDS="3600"
# Tokens de webhook Inter
INTER_WEBHOOK_TOKEN=""
INTER_PIX_WEBHOOK_TOKEN=""
INTER_BOLETO_WEBHOOK_TOKEN=""
INTER_COBRANCA_WEBHOOK_TOKEN=""

# ==========================================
# EMAIL (RESEND) E NOTIFICACOES PUSH (VAPID)
# ==========================================
RESEND_KEY=""
RESEND_FROM_EMAIL="no-reply@exemplo.com"
RESEND_FROM_NAME="Pflix"
WEBPUSH_VAPID_PUBLIC_KEY=""
WEBPUSH_VAPID_PRIVATE_KEY=""
WEBPUSH_VAPID_SUBJECT="mailto:admin@exemplo.com"

# ==========================================
# CRON JOBS E MONITORAMENTO
# ==========================================
CRON_DISPATCH_SECRET=""
UPTIME_CRON_SECRET=""

# ==========================================
# METADADOS DE DEPLOY (PREENCHIDOS PELA PLATAFORMA)
# ==========================================
GITHUB_SHA=""
VERCEL_DEPLOYMENT_ID=""
VERCEL_GIT_COMMIT_REF=""
VERCEL_GIT_COMMIT_SHA=""
VERCEL_REGION=""
