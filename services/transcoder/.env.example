# Autenticacao obrigatoria (o servico recusa iniciar sem este token)
TRANSCODER_TOKEN=troque-por-um-token-longo-e-aleatorio

# Rede (escuta apenas loopback por padrao)
TRANSCODER_HOST=127.0.0.1
TRANSCODER_PORT=8001

# Execucao, fila e recursos de CPU
TRANSCODER_WORKDIR=/var/tmp/pflix-transcoder
TRANSCODER_CONCURRENCY=1
TRANSCODER_THREADS=6

# Storage compativel com S3 (tambem aceita WASABI_* como alternativa)
S3_ENDPOINT=https://s3.us-east-1.wasabisys.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sua-access-key
S3_SECRET_ACCESS_KEY=sua-secret-key
S3_BUCKET_NAME=seu-bucket
